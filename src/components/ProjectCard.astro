---
import { Image } from "astro:assets";
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const titleId = "project-" + project.id;
const number = String(project.id).padStart(2, "0");
---

<article class="project-card" aria-labelledby={titleId}>
  <a
    class="project-link"
    href={project.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={project.title + ": visitar proyecto (abre en una pestaña nueva)"}
  >
    <header class="project-header">
      <div class="project-heading">
        <span class="project-number">{number}</span>
        <div>
          <p class="project-category">{project.category}</p>
          <h2 id={titleId}>{project.title}</h2>
        </div>
      </div>
      <span class="project-arrow" aria-hidden="true">
<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M19 4.25C19.4142 4.25 19.75 4.58579 19.75 5V13C19.75 13.4142 19.4142 13.75 19 13.75C18.5858 13.75 18.25 13.4142 18.25 13V6.81066L5.53033 19.5303C5.23744 19.8232 4.76256 19.8232 4.46967 19.5303C4.17678 19.2374 4.17678 18.7626 4.46967 18.4697L17.1893 5.75H11C10.5858 5.75 10.25 5.41421 10.25 5C10.25 4.58579 10.5858 4.25 11 4.25H19Z" fill="currentColor"></path></svg>
      </span>
    </header>

    <div class="project-details">
      <p class="project-description">{project.description}</p>
      <p class="project-year">
        <span>Año</span>
        <strong>{project.year}</strong>
      </p>
    </div>

    <ul class="project-stack" aria-label={"Tecnologías de " + project.title}>
      {project.stack.map((technology) => <li>{technology}</li>)}
    </ul>

    <div class="project-visual">
      {
        project.image ? (
          <Image
            class="project-image"
            src={project.image}
            alt={"Vista previa de " + project.title}
            loading="lazy"
          />
        ) : (
          <span>PROJECT VISUAL — COMING SOON</span>
        )
      }
    </div>
  </a>
</article>
