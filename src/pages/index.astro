---
import PersonalIntro from "@/components/PersonalIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Edzon Perez — Fullstack Engineer";
const description =
  "Portfolio de Edzon Perez, Fullstack Engineer que crea productos digitales claros, útiles y técnicamente sólidos.";
---

<BaseLayout title={title} description={description}>
  <main id="contenido" class="site-shell">
    <PersonalIntro />
    <div class="projects-placeholder" aria-label="Proyectos seleccionados"></div>
  </main>
</BaseLayout>
